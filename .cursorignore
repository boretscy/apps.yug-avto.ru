# Исключаем зависимости (ИИ знает синтаксис стандартных библиотек, 
# а локальный индекс вендоров только забьет контекст)
/vendor/
/go/pkg/mod/

# Логи и кэш
*.log
.cache/
.tmp/

# Специфичные папки IDE и Docker
.git/
.idea/
.docker/

# Бинарники Go и скомпилированные файлы
/go/bin/
/go/dist/
/go/build/
